# Supabase (required)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# Development test account — tap page title 5 times to reveal dev login panel
VITE_DEV_TEST_EMAIL=admin@test.dev
VITE_DEV_TEST_PASSWORD=YourDevPassword!

# --- Supabase Edge Function Secrets (set in Supabase dashboard → Settings → Secrets) ---

# Allowed CORS origin for Edge Functions (set to your production domain)
# ALLOWED_ORIGIN=https://yourdomain.com

# VAPID keys for Web Push notifications (generate with: npx web-push generate-vapid-keys)
# VAPID_KEYS={"publicKey":"...","privateKey":"..."}