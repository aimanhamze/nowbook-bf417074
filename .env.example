# Supabase (required)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# Development test account — tap page title 5 times to reveal dev login panel
VITE_DEV_TEST_EMAIL=admin@test.dev
VITE_DEV_TEST_PASSWORD=YourDevPassword!

# --- Supabase Edge Function Secrets (set in Supabase dashboard → Settings → Secrets) ---

# Allowed CORS origin for Edge Functions (set to your production domain)
# ALLOWED_ORIGIN=https://yourdomain.com

# Web Push public key (optional). Unset = PROD's key, hardcoded in
# src/hooks/usePushSubscription.ts. Set it only when this build talks to a
# project with different VAPID_KEYS (e.g. DEV) — line 2 of the command below.
# VITE_VAPID_PUBLIC_KEY=

# VAPID keys for Web Push (Edge Function secret). A JSON pair of JWKs, as
# @negrel/webpush exports them — NOT the base64 strings `npx web-push` prints,
# which fail to import. Generate with:
#   deno eval --no-lock 'import * as w from "jsr:@negrel/webpush@0.5.0"; const k = await w.generateVapidKeys({ extractable: true }); console.log(JSON.stringify(await w.exportVapidKeys(k))); console.log(await w.exportApplicationServerKey(k));'
# Line 1 is VAPID_KEYS; line 2 is the matching public key for the browser.
# VAPID_KEYS={"publicKey":{"kty":"EC","crv":"P-256","x":"...","y":"...",...},"privateKey":{"kty":"EC","crv":"P-256","d":"...","x":"...","y":"...",...}}