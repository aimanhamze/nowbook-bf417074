# Copy to supabase/functions/.env (gitignored) for local runs of send-sms-hook.
# PLACEHOLDERS ONLY. Never commit real values; on Supabase, set them with
# `supabase secrets set` instead.

# From Authentication > Hooks > Send SMS (format: v1,whsec_<base64>).
SEND_SMS_HOOK_SECRET=v1,whsec_REPLACE_WITH_BASE64_SECRET

# Shmor Makom API key.
SHMOR_API_KEY=REPLACE_WITH_SHMOR_API_KEY

# Approved sender name. Defaults to Ehjezly when unset.
SHMOR_SENDER=Ehjezly

# true = call /v1/sms/estimate (nothing sent, nothing charged).
SMS_DRY_RUN=true

# Optional allowlist. When set, ONLY these numbers go to Shmor; all others go
# to fallback. Comma-separated, e.g. 0501234567,+972521234567
SHMOR_TEST_PHONES=
